# Caddy on titan — single source of truth for *.harker.systems routing.
#
# Public traffic enters via Cloudflare Tunnel (`sso-home-lab` on titan).
# Cloudflare Access enforces auth at the edge; Caddy trusts the CF JWT
# header and routes by Host. TLS terminates at Cloudflare's edge — Caddy
# is HTTP-only on port 80.
#
# Deploy: docker compose up -d
# Reload: docker exec caddy caddy reload --config /etc/caddy/Caddyfile

{
    auto_https off
    servers {
        trusted_proxies cloudflare
    }
}

# ─── snippets ──────────────────────────────────────────────────

# Defense-in-depth: refuse anything that didn't come through CF Access.
# Drop this from any service whose CF Access app is set to "bypass".
(cf_access_required) {
    @no_jwt not header Cf-Access-Authenticated-User-Email *
    respond @no_jwt 403
}

# Self-signed upstream — used by Proxmox, Wazuh, Portainer, Nessus, Omada.
(self_signed_https) {
    transport http {
        tls
        tls_insecure_skip_verify
    }
}

