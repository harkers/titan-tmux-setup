# Caddy on titan — single source of truth for *.harker.systems routing.
#
# Public traffic enters via Cloudflare Tunnel `harker.systems` (8ba2b285...).
# Cloudflare Access is enforced at the tunnel ingress level via audTag —
# Caddy receives only authenticated requests for protected services.
# TLS terminates at Cloudflare's edge — Caddy is HTTP-only on port 80.
#
# Deploy: docker compose up -d
# Reload: docker exec caddy caddy reload --config /etc/caddy/Caddyfile

{
	auto_https off
}

# ─── snippet: self-signed upstream ─────────────────────────────
# Used for upstreams with self-signed certs (Proxmox, Wazuh,
# Portainer, Nessus, Omada).
(self_signed_https) {
	transport http {
		tls
		tls_insecure_skip_verify
	}
}

# ─── titan-local services ──────────────────────────────────────

http://posterizarr.harker.systems {
	reverse_proxy 127.0.0.1:8000 {
		lb_try_duration 4s
		lb_try_interval 250ms
		transport http {
			dial_timeout 8s
		}
	}
}

