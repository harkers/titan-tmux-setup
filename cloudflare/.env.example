# Cloudflare API credentials for harker.systems management.
# Copy to .env (chmod 600) on titan, or use existing OE token at
# /Users/stu/Projects/ordered-edge/.env.secrets on Mac.

# Token must have these scopes:
#   Zone   · DNS                       · Edit  on harker.systems
#   Account · Cloudflare Tunnel        · Edit  on this account
#   Account · Access: Apps and Policies · Edit on this account

CF_API_TOKEN=<your-token-here>
CF_ACCOUNT_ID=<your-account-id>
